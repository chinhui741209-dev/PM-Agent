# ============================================================
#  AI Agent PM — 環境設定範本
#  複製成 .env 後填入你的金鑰：  cp .env.example .env
# ============================================================

# ---- OpenAI（產生 WBS 必填）----
# 在 https://platform.openai.com/api-keys 建立
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 產生 WBS 用的模型（預設 gpt-4o，可改 gpt-4o-mini / gpt-4.1 等）
WBS_MODEL=gpt-4o
# 選填：自架 / Azure / 相容端點才需要填，官方 OpenAI 請留空
OPENAI_BASE_URL=

# ---- Jira Cloud（部署到 Jira 時才需要）----
# 例：https://your-domain.atlassian.net
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
# 在 https://id.atlassian.com/manage-profile/security/api-tokens 建立
JIRA_API_TOKEN=xxxxxxxxxxxxxxxx

# ---- 其他（一般不用改）----
# 前端開發 origin（CORS），逗號分隔
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WBS 草稿存放目錄
DATA_DIR=./data
