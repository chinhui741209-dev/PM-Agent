# ============================================================
#  AI Agent PM — 環境設定範本
#  複製成 .env 後填入你的金鑰：  cp .env.example .env
# ============================================================

# ---- LLM（產生 WBS，透過 OpenAI 相容 API）----
# 預設：本地 Ollama（免費、免金鑰）。先 `ollama pull qwen2.5:7b` 並啟動 `ollama serve`
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama                 # 佔位即可，Ollama 不驗證金鑰
WBS_MODEL=qwen2.5:7b                   # 想更高品質可改 qwen2.5:14b
#
# 若要改用官方 OpenAI：改成下面這組（base_url 留空走官方）
# OPENAI_BASE_URL=
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx   # https://platform.openai.com/api-keys
# WBS_MODEL=gpt-4o                     # 或 gpt-4o-mini / gpt-4.1 等

# ---- Jira Cloud（部署到 Jira 時才需要）----
# 例：https://your-domain.atlassian.net
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
# 在 https://id.atlassian.com/manage-profile/security/api-tokens 建立
JIRA_API_TOKEN=xxxxxxxxxxxxxxxx

# ---- 其他（一般不用改）----
# 前端開發 origin（CORS），逗號分隔
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WBS 草稿存放目錄
DATA_DIR=./data
